<!-- Shaking bell: indigo bell, green clapper, sky-blue shake marks — the same
     three colors as the Expense Tracker logo. Drawn in a 240-unit sketch space
     centered on (120,92), then scaled/translated into the adaptive icon's
     66dp safe zone (group transforms apply scale, rotate, then translate). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="120"
        android:pivotY="92"
        android:scaleX="0.62"
        android:scaleY="0.62"
        android:translateX="-66"
        android:translateY="-38">
        <group
            android:pivotX="120"
            android:pivotY="92"
            android:rotation="-14">
            <!-- bell knob + body -->
            <path
                android:fillColor="#6366F1"
                android:pathData="M120,64 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />
            <path
                android:fillColor="#6366F1"
                android:pathData="M120,66 c-14,0 -22,11 -22,24 v14 l-7,9 h58 l-7,-9 v-14 c0,-13 -8,-24 -22,-24 z" />
            <!-- clapper -->
            <path
                android:fillColor="#34D399"
                android:pathData="M120,119 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
        </group>
        <!-- shake marks -->
        <path
            android:strokeColor="#38BDF8"
            android:strokeWidth="5"
            android:strokeLineCap="round"
            android:pathData="M82,74 q-9,17 0,34" />
        <path
            android:strokeColor="#38BDF8"
            android:strokeWidth="5"
            android:strokeLineCap="round"
            android:pathData="M158,74 q9,17 0,34" />
    </group>
</vector>
