# Copy to keystore.properties (same folder, git-ignored) and fill in.
# See README → "Release builds". Paths use forward slashes, even on Windows.
storeFile=C:/Users/<user>/keys/wakku-release.jks
storePassword=<keystore password>
keyAlias=wakku
keyPassword=<key password, same as storePassword for PKCS12 keystores>
